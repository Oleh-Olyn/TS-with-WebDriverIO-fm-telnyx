{
  "name": "TS-with-WebDriverIO-fm-telnyx",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "wdio": "wdio run ./wdio.conf.js",
    "test": "npm run test:chrome",
    "test:all": "wdio run ./wdio.conf.js",
    "test:chrome": "cross-env BROWSER=chrome wdio run ./configs/chrome.conf.js",
    "test:firefox": "cross-env BROWSER=firefox wdio run ./configs/firefox.conf.js",
    "test:edge": "cross-env BROWSER=edge wdio run ./configs/edge.conf.js",
    "test:chrome:headless": "cross-env BROWSER=chrome HEADLESS=true wdio run ./configs/chrome.conf.js",
    "test:firefox:headless": "cross-env BROWSER=firefox HEADLESS=true wdio run ./configs/firefox.conf.js",
    "test:file": "wdio run ./wdio.conf.js --spec",
    "allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "allure open ./allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "test:chrome:report": "npm run test:chrome && npm run allure:report",
    "test:firefox:report": "npm run test:firefox && npm run allure:report"
  },
  "devDependencies": {
    "@wdio/allure-reporter": "^9.30.1",
    "@wdio/cli": "^9.30.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "allure-commandline": "^2.43.0",
    "cross-env": "^10.1.0"
  }
}
